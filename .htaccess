# Custom error pages
ErrorDocument 404 /404.html

# Serve HTML content for the root
DirectoryIndex index.html index.htm

# Enable rewrite engine
RewriteEngine On
RewriteBase /

# Redirect www to non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.johnb\.io [NC]
RewriteRule ^ https://johnb.io%{REQUEST_URI} [R=301,L]

# Removed pages — permanent redirect to home
RewriteRule ^(project-insights|michael-scott)(\.html)?$ https://johnb.io/ [R=301,L]

# Legacy tool URL — ytsum was renamed to transcripts
RewriteRule ^ytsum(\.html)?$ https://johnb.io/transcripts [R=301,L]

# Retired tools — redirect to the closest surviving page instead of 404
RewriteRule ^youtube-analyzer(\.html)?$ https://johnb.io/transcripts [R=301,L,NC]
RewriteRule ^cv-cover-letter(\.html)?$ https://johnb.io/aitocv [R=301,L,NC]
RewriteRule ^eu-ai-act(\.html)?$ https://johnb.io/course/ai-governance-frameworks [R=301,L,NC]

# Retired pages — deleted 18 Aug 2026, redirected to the closest surviving page.
# These sit above the .html-stripping rule so /page.html redirects to its new
# home in one hop instead of chaining through /page first.
#
# course.html was an unreachable duplicate: /course has always been served by
# course/index.html, and nothing in the codebase ever linked to the root file.
RewriteRule ^course\.html$ https://johnb.io/course/ [R=301,L,NC]
# template.html was a stripped copy of text-to-voice.html sharing its title.
RewriteRule ^template(\.html)?$ https://johnb.io/text-to-voice [R=301,L,NC]
# heart.html was an off-topic nutrition guide.
RewriteRule ^heart(\.html)?$ https://johnb.io/ [R=301,L,NC]
# Two thin explainer articles retired against scaled-content signals.
RewriteRule ^news/ai-terms-explained(\.html)?$ https://johnb.io/news/ai-models-2026 [R=301,L,NC]
RewriteRule ^news/test-ai(\.html)?$ https://johnb.io/news/geo-generative-engine-optimisation [R=301,L,NC]

# Strip .html extension — redirect /page.html to /page
#
# header.html and footer.html are exempt. scripts.js fetches them at their real
# .html path on every single page load; without this exemption each fetch takes
# a 301 to /header before landing back on header.html, so every visitor and
# every crawler pays two extra round trips per page.
RewriteCond %{REQUEST_URI} !^/(header|footer)\.html$ [NC]
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# The nav fragments have exactly one valid URL each, the .html one. Anything
# else 404s so they cannot be indexed as pages in their own right.
RewriteRule ^(header|footer)/?$ - [R=404,L,NC]

# Force the home page to use index.html
RewriteRule ^$ index.html [L]

# Redirect /blog to /news
RewriteRule ^blog/?$ /news [R=301,L]

# Serve news directory index directly (bypass Passenger)
RewriteRule ^news/?$ news/index.html [L]

# Serve course directory index directly (bypass Passenger)
RewriteRule ^course/?$ course/index.html [L]

# Route /verify/{certId} to verify.html (public certificate verification)
RewriteRule ^verify/[A-Z0-9-]+$ /verify.html [L]

# Map extensionless page URLs to their .html file — /meditation -> meditation.html
#
# The two guards below are load-bearing, do not remove them.
#
# Unguarded, this rule matched ANY path that wasn't a real file, appended
# .html, and then matched its own output again: /images/nope.webp became
# nope.webp.html, then nope.webp.html.html, until the server gave up and
# returned 500. Every missing image, stale asset reference and mistyped
# directory URL on the site served a 5xx instead of a 404, and sustained 5xx
# is one of the few things that makes Google throttle crawling of a whole host.
#
#   !\.[A-Za-z0-9]+$  - a path that already carries a file extension is an
#                       asset request, not a page. It also terminates the loop,
#                       because this rule's own output always ends in .html.
#   ^(.*[^/])$        - a path ending in / is a directory request. Appending
#                       .html to it produced "dir/.html" and looped.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !\.[A-Za-z0-9]+$
RewriteRule ^(.*[^/])$ $1.html [L]

# Enable range requests for audio files (allows browser to stream/seek)
<IfModule mod_headers.c>
    <FilesMatch "\.(mp3|m4a|mp4|ogg|wav)$">
        Header set Accept-Ranges bytes
    </FilesMatch>
</IfModule>

# Handle font files caching
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Specific rule for CORBEL.TTF
    <Files "CORBEL.TTF">
        Header set Cache-Control "max-age=31536000, public"
    </Files>
</IfModule>

# Enable expires headers
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML — no cache so users always get the latest page
    ExpiresByType text/html "access plus 0 seconds"

    # Dataset export — refresh daily, not on the 1 month ExpiresDefault
    ExpiresByType application/json "access plus 1 day"

    # Others
    ExpiresDefault "access plus 1 month"
</IfModule>

# HTML must-revalidate
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Nav fragments: crawlable so Googlebot can render site navigation, but never
# indexed as standalone pages. Separate <Files> blocks — LiteSpeed ignores
# Header directives that carry an env= condition.
<IfModule mod_headers.c>
    <Files "header.html">
        Header set X-Robots-Tag "noindex"
    </Files>
    <Files "footer.html">
        Header set X-Robots-Tag "noindex"
    </Files>
</IfModule>

# Add version to static assets
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.+)\.(\d+)\.(bmp|css|cur|gif|ico|jpe?g|js|png|svgz?|webp|webmanifest)$ $1.$3 [L]
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json
</IfModule>

# Brotli compression (if available on server)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI text/html text/plain text/xml text/css application/javascript text/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.amcharts.com https://cdn.tailwindcss.com https://unpkg.com https://apis.google.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://*.ukjbowman.workers.dev https://*.googleapis.com https://*.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://www.gstatic.com https://api.stripe.com https://checkout.stripe.com; frame-src https://accounts.google.com https://johnblogin-fdcc6.firebaseapp.com https://www.youtube.com https://www.youtube-nocookie.com https://checkout.stripe.com; media-src 'self' blob:; object-src 'none';"
    Header set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"

    # The poker replayer is embeddable by design (iframe embed code), so it is
    # exempt from X-Frame-Options. Everything else stays SAMEORIGIN.
    <Files "live-poker-hand-replayer.html">
        Header unset X-Frame-Options
    </Files>
</IfModule>

# Prevent directory listing
Options -Indexes

# Prevent access to .htaccess file
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Block server error log from public access
<Files "error_log">
    Order allow,deny
    Deny from all
</Files>


# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

AddType text/css .css
AddType audio/mpeg .mp3
AddType audio/mp4 .m4a
AddType audio/x-m4a .m4a
